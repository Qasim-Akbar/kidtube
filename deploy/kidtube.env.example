# /etc/kidtube/kidtube.env
#
# Created by deploy/install.sh (secrets generated, KIDTUBE_PORT-style values taken from deploy/deploy.env); never
# overwritten once it exists. Mode MUST be 0600 root:root: it holds the JWT secret and the database password.
# systemd reads it as root, so the service user does not need access to the file.
#
# Format: this file is read by systemd (EnvironmentFile=), not by a shell. One KEY=value per line, no spaces around
# "=", no "export", and NO trailing comments after a value (they would become part of the value).
# deploy.sh refuses to continue while any value still contains CHANGE_ME.

# prod: enforces a real JWT_SECRET (the app refuses to start with the default) and turns off /docs, /redoc, /openapi.json.
APP_ENV=prod

# Signs every login. Generate ONE and keep it:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later logs every parent out (existing access and refresh tokens stop validating).
# Kid devices use their own stored tokens and are not affected.
JWT_SECRET=CHANGE_ME_JWT_SECRET

# PostgreSQL on this machine. Use a password without special characters, e.g.  openssl rand -hex 24
# (anything else must be URL-encoded inside this URL).
# Option A (default): TCP to localhost, password + scram-sha-256.
DATABASE_URL=postgresql+psycopg://@KIDTUBE_DB_USER@:CHANGE_ME_DB_PASSWORD@127.0.0.1:@KIDTUBE_PG_PORT@/@KIDTUBE_DB_NAME@

# Access tokens are short; the refresh token keeps parents signed in.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Family timezone used when /auth/register does not send one. Day boundaries (feeds, reports, limits) follow it.
DEFAULT_TIMEZONE=Asia/Karachi

# ###########################################################################################################
# ##  ALLOW_REGISTRATION=true IS ONLY FOR CREATING THE FIRST PARENT ACCOUNT.                               ##
# ##  As soon as that account exists, set it to false and run:  sudo systemctl restart kidtube             ##
# ##  While it is true, ANYONE who finds the URL can create a family on your server.                       ##
# ###########################################################################################################
ALLOW_REGISTRATION=true

# Behind nginx (deploy/nginx/kidtube.conf), which OVERWRITES X-Forwarded-For with the real client address.
# true = the app reads the client IP for the login / pairing rate limits from that header.
# Must be false if clients can reach uvicorn directly (it only listens on 127.0.0.1, so they cannot).
TRUST_PROXY_HEADERS=true

# Rate limits applied by the app (failed attempts per window). nginx has looser limits in front.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=10
PAIR_MAX_FAILURES=5
PAIR_FAILURE_WINDOW_MINUTES=10
PAIR_CODE_MINUTES=10

# How many days back (family-local) an offline device may still upload events.
EVENT_MAX_AGE_DAYS=30

# Interactive API docs (/docs, /redoc, /openapi.json): off. (nginx also answers 404 for them.)
ENABLE_DOCS=false
