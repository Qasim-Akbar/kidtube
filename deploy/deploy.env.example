# KidTube deployment settings: the ONE file every script in deploy/ reads.
#
#   cp deploy/deploy.env.example deploy/deploy.env     (deploy.env is git-ignored)
#   nano deploy/deploy.env
#
# Plain KEY=value lines, no quotes, no spaces around "=", no trailing comments. The scripts parse this file
# (they never `source` it) and refuse values that contain anything unusual.
# Use another location with:  KIDTUBE_DEPLOY_ENV=/path/to/file deploy/check.sh

# ---- must fill in -------------------------------------------------------------------------------------------
# The ONE host name nginx will answer for (a subdomain you own, DNS A record already pointing at this VPS).
KIDTUBE_DOMAIN=CHANGE_ME.example.com
# Contact address for Let's Encrypt (expiry warnings). Sent to Let's Encrypt only.
LETSENCRYPT_EMAIL=CHANGE_ME@example.com

# ---- defaults, change only if check.sh reports a conflict ------------------------------------------------------
# Unprivileged system user the API runs as (created by install.sh if missing).
KIDTUBE_USER=kidtube
# uvicorn listens on 127.0.0.1:KIDTUBE_PORT (never on a public address). nginx proxies to it.
KIDTUBE_PORT=8001
# Code, virtualenv and constraints go here. Keep it outside /home (the unit uses ProtectHome=yes).
KIDTUBE_DIR=/opt/kidtube

# PostgreSQL: a dedicated role and database, created by install.sh (no superuser; other databases untouched).
KIDTUBE_DB_NAME=kidtube
KIDTUBE_DB_USER=kidtube
# Port of the PostgreSQL cluster you want to use (`pg_lsclusters`). Connections are 127.0.0.1 only.
KIDTUBE_PG_PORT=5432

# Where the service reads its settings and secrets (mode 0600, root only; systemd reads it).
KIDTUBE_ENV_FILE=/etc/kidtube/kidtube.env

# Certificates: "webroot" (default: nginx keeps running untouched, challenge files go to KIDTUBE_WEBROOT) or
# "nginx" (certbot's nginx plugin; it briefly edits and reloads nginx for this domain only).
KIDTUBE_CERT_METHOD=webroot
KIDTUBE_WEBROOT=/var/www/kidtube-acme

# Add "listen [::]:80/443" lines? auto = only if nginx already listens on IPv6 here; yes / no to force.
KIDTUBE_NGINX_IPV6=auto

# Database dumps: daily, the newest KIDTUBE_BACKUP_KEEP files are kept.
KIDTUBE_BACKUP_DIR=/var/backups/kidtube
KIDTUBE_BACKUP_KEEP=14
