# /etc/fail2ban/jail.d/kidtube-sshd.local   then: sudo systemctl enable --now fail2ban && sudo systemctl restart fail2ban
# Bans an address for an hour after 5 failed SSH logins within 10 minutes (repeat offenders get longer bans).
# Ubuntu 24.04 logs SSH to the systemd journal, hence backend = systemd.
# Add your own fixed address to ignoreip if you have one, so a typo cannot lock you out.
[DEFAULT]
ignoreip = 127.0.0.1/8 ::1

[sshd]
enabled = true
backend = systemd
maxretry = 5
findtime = 10m
bantime = 1h
bantime.increment = true
