<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY (this file overrides src/main/res/xml/network_security_config.xml, which keeps release https-only).
  Plain http is allowed to any host so a dev PC can be reached by its LAN address (e.g. http://192.168.1.20:8001) from
  a real phone or from the emulator, as well as 10.0.2.2 and 127.0.0.1 (adb reverse). ServerAddressPolicy still decides
  what the address field accepts (http only when BuildConfig.ALLOW_CLEARTEXT_API, which is debug only).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
