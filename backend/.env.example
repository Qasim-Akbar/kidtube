APP_ENV=dev
# SQLite for dev; Postgres for production, e.g.
# DATABASE_URL=postgresql+psycopg://kidtube:change-me@localhost:5432/kidtube
DATABASE_URL=sqlite:///./kidtube.db
# Required (not "change-me") whenever APP_ENV is not "dev". Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
DEFAULT_TIMEZONE=Asia/Karachi
# Set to false on the VPS once the family has been created.
ALLOW_REGISTRATION=true
PAIR_CODE_MINUTES=10
PAIR_MAX_FAILURES=5
PAIR_FAILURE_WINDOW_MINUTES=10
# Failed logins are limited per client IP and, separately, per email.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=10
# Only set true behind a reverse proxy (Nginx) that sets X-Forwarded-For; otherwise clients can spoof their IP.
TRUST_PROXY_HEADERS=false
# How many days back (family-local) an offline device may still upload events; older ones are rejected.
EVENT_MAX_AGE_DAYS=30
# Interactive API docs (/docs, /redoc, /openapi.json). Leave unset: on only when APP_ENV=dev. Never enable in production.
# ENABLE_DOCS=false
