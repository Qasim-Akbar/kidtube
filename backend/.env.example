APP_ENV=dev
# SQLite for dev; Postgres for production, e.g.
# DATABASE_URL=postgresql+psycopg://kidtube:change-me@localhost:5432/kidtube
DATABASE_URL=sqlite:///./kidtube.db
# Required (not "change-me") whenever APP_ENV is not "dev". Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
DEFAULT_TIMEZONE=Asia/Karachi
# Set to false on the VPS once the family has been created.
ALLOW_REGISTRATION=true
PAIR_CODE_MINUTES=10
PAIR_MAX_FAILURES=5
PAIR_FAILURE_WINDOW_MINUTES=10
# Only set true behind a reverse proxy (Nginx) that sets X-Forwarded-For; otherwise clients can spoof their IP.
TRUST_PROXY_HEADERS=false
